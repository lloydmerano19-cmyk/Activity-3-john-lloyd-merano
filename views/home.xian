
<!-- <%- include('partials/head') %> -->

    <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold text-center mt-10">
            Welcome to XianFire 🔥
        </h1>
        <p class="text-center mt-4">Home Page</p>
        <a href="/add">add new</a>
    </div>

    <table>
        <tr>
            <td>id</td>
            <td>Name</td>
            <td>category</td>
            <td>quantity</td>
            <td>price</td>
            <td>date</td>
        </tr>
           {{#each data}}
            <tr>
                <td>{{id}}</td>
                <td>{{Name}}</td>
                <td>{{category}}</td>
                <td>{{quantity}}</td>
                <td>{{price}}</td>
                <td>{{date}}</td>
                <td> <a href="/edit/{{id}}">edit</a>
                    <a href="/delete/{{id}}">delete</a>
                  
                </td>
            </tr>

            {{/each}}
    </table>
